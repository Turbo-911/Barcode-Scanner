# Incremental build used by run_gui.bat (MSYS2 UCRT64, mingw32-make).
# Each source file compiles once into build_obj/; later builds only
# recompile what changed (the .d files track header dependencies),
# then link. Delete the build_obj folder to force a full rebuild.
# (Named Makefile.gui because the repo .gitignore ignores "Makefile".)
.RECIPEPREFIX = >

CXX      := g++
CXXFLAGS := -std=c++17 -O2 -D_WIN32 -Isrc -MMD -MP
LDLIBS   := -lsfml-graphics -lsfml-window -lsfml-system -lmf -lmfplat -lmfreadwrite -lmfuuid -lole32 -loleaut32 -lcomdlg32 -luuid
TARGET   := barcode_studio_gui.exe
OBJDIR   := build_obj

SRCS := src/main.cpp src/App.cpp \
    src/barcode/encoder.cpp src/barcode/Decoder.cpp \
    src/camera/camera.cpp \
    src/common/BMP.cpp src/common/image.cpp src/common/image_io.cpp \
    src/common/string_utils.cpp src/common/date_time.cpp \
    src/domain/enums.cpp \
    src/domain/payment_rules.cpp \
    src/persistence/record_file.cpp src/persistence/product_serialiser.cpp src/persistence/order_serialiser.cpp \
    src/persistence/order_detail_serialiser.cpp src/persistence/bill_serialiser.cpp \
    src/persistence/bill_detail_serialiser.cpp src/persistence/category_serialiser.cpp src/persistence/seasons_serialiser.cpp \
    src/persistence/journal_serialiser.cpp src/persistence/journal_repo.cpp src/persistence/audit_log.cpp \
    src/persistence/i_product_repo.cpp src/persistence/i_order_repo.cpp src/persistence/i_bill_repo.cpp \
    src/persistence/i_bill_detail_repo.cpp src/persistence/i_category_repo.cpp src/persistence/i_seasons_repo.cpp \
    src/services/id_generator.cpp src/services/bill_calculator.cpp src/services/bill_service.cpp \
    src/services/product_services.cpp src/services/order_service.cpp src/services/scan_service.cpp \
    src/services/category_service.cpp src/services/seasons_service.cpp src/services/report_service.cpp src/services/pdf_bill.cpp \
    src/ui/BarcodeStudioGui.cpp src/ui/Widgets.cpp

OBJS := $(SRCS:%.cpp=$(OBJDIR)/%.o)
DEPS := $(OBJS:.o=.d)

# D-14/D-35: the object folders are created by make itself, so a direct
# `mingw32-make -f Makefile.gui` works on a fresh clone without run_gui.bat.
# NOTE (v36 fix): `all` must stay the FIRST target in this file - it is the
# default goal. In v35 the build_obj rule below came first, so plain
# `mingw32-make -f Makefile.gui` stopped after the folders existed
# ("build_obj is up to date") and never compiled anything.
all: $(TARGET)

$(OBJDIR):
>mkdir $(OBJDIR)
>mkdir $(OBJDIR)/src
>mkdir $(OBJDIR)/src/barcode
>mkdir $(OBJDIR)/src/camera
>mkdir $(OBJDIR)/src/common
>mkdir $(OBJDIR)/src/domain
>mkdir $(OBJDIR)/src/persistence
>mkdir $(OBJDIR)/src/services
>mkdir $(OBJDIR)/src/ui

$(TARGET): $(OBJS)
>$(CXX) $(OBJS) -o $@ $(LDLIBS)

$(OBJDIR)/%.o: %.cpp | $(OBJDIR)
>$(CXX) $(CXXFLAGS) -c $< -o $@

-include $(DEPS)

# D-13: build pos_selftest and run it in a fresh temp folder, never in
# the repo root - it seeds (truncates) Data/*.txt in its working dir.
# The test itself also refuses to run against a non-empty catalogue.
# On a failure make stops here, leaving pos_selftest_run/ behind with
# the seeded data for inspection; on success the folder is removed.
TESTSRCS := tests/pos_selftest.cpp $(wildcard src/persistence/*.cpp src/services/*.cpp src/domain/*.cpp) src/common/string_utils.cpp src/common/date_time.cpp
TESTBIN := pos_selftest.exe
TESTDIR := pos_selftest_run

$(TESTBIN): $(TESTSRCS)
>$(CXX) -std=c++17 -Isrc $(TESTSRCS) -o $@

test: $(TESTBIN)
>if exist $(TESTDIR) rmdir /s /q $(TESTDIR)
>mkdir $(TESTDIR)
>copy $(TESTBIN) $(TESTDIR)
>cd $(TESTDIR) && $(TESTBIN)
>rmdir /s /q $(TESTDIR)

clean:
>if exist $(OBJDIR) rmdir /s /q $(OBJDIR)

.PHONY: all clean test
